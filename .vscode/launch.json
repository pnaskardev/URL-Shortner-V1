  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Core",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/core",
      "showLog": true
    },
    {
      "name": "Launch ShortenerService",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/shortener-service",
      "showLog": true
